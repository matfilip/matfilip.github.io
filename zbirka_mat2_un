Neodgovorjena naloga prinese $0$ to"ck, obkro"zen ve"c kot en odgovor pa minus $1$ to"cko.
Odgovorite tako, da obkro"zite "crko pred pravilnim odgovorom.



\begin{enumerate}

\item{[25T]}
Dolo"cite vse realne lastne vrednosti matrike 
$$
A=\begin{pmatrix}
2&1&0\\
1&2&1\\
0&1&2
\end{pmatrix}
$$
in določite lastni vektor, ki pripada največji lastni vrednosti.

\medskip
\textbf{Rešitev.}
Karakteristi"cni polinom dobimo iz
\[
\det(A-\lambda I)=
\begin{vmatrix}
2-\lambda&1&0\\
1&2-\lambda&1\\
0&1&2-\lambda
\end{vmatrix}
=(2-\lambda)\bigl((2-\lambda)^2-1\bigr)-(2-\lambda)
=(2-\lambda)\bigl((2-\lambda)^2-2\bigr).
\]
Ničle tega polinoma so
\[
\lambda_1=2+\sqrt{2},\qquad \lambda_2=2,\qquad \lambda_3=2-\sqrt{2},
\]
torej ima $A$ tri različne realne lastne vrednosti.

Največja lastna vrednost je $\lambda_{\max}=2+\sqrt{2}$. Za pripadajoči lastni vektor $v=(x,y,z)^\top$ rešimo $(A-\lambda_{\max}I)v=0$, tj.
\[
\begin{pmatrix}
-\sqrt{2}&1&0\\
1&-\sqrt{2}&1\\
0&1&-\sqrt{2}
\end{pmatrix}
\begin{pmatrix}x\\y\\z\end{pmatrix}
=
\begin{pmatrix}0\\0\\0\end{pmatrix}.
\]
Iz prve vrstice dobimo $-\sqrt{2}\,x+y=0$, torej $y=\sqrt{2}\,x$. Iz druge vrstice sledi
$x-\sqrt{2}\,y+z=0 \;\Rightarrow\; x-2x+z=0 \;\Rightarrow\; z=x$.
Tretja vrsta je odvisna od prvih dveh. Izberemo $x=1$ in dobimo lastni vektor
\[
v=\begin{pmatrix}1\\ \sqrt{2}\\ 1\end{pmatrix}.
\]




\item{[25T]}
Poi"s"cite re"sitev diferencialne ena"cbe 
$$
x y'-y=x^3\sin(x^2).
$$

\textbf{Re"sitev.} Za"cetno diferencialno ena"cbo delimo z $x$ in najprej poi"s"cemo re"sitev homogenega dela 
\[
y'-\frac{y}{x}=0.
\]
Dobimo 
\[
\frac{dy}{y}=\frac{dx}{x}\quad\Rightarrow\quad y_h=Cx.
\]
Z variacijo konstante vzamemo $y_p=x\,C(x)$. Tedaj
\[
y_p'-\frac{y_p}{x}=(C+xC')-\frac{1}{x}(xC)=x\,C'(x),
\]
zato iz $y'-\frac{y}{x}=x^2\sin(x^2)$ sledi
\[
x\,C'(x)=x^2\sin(x^2)\quad\Rightarrow\quad C'(x)=x\sin(x^2).
\]
Integriramo s substitucijo $u=x^2$, $du=2x\,dx$ (torej $x\,dx=\tfrac12\,du$):
\[
C(x)=\int x\sin(x^2)\,dx=\frac12\int \sin u\,du
=-\frac12\cos u + C_0
=-\frac12\cos(x^2)+C_0.
\]
Za partikularno re"sitev lahko vzamemo $C_0=0$, torej
\[
y_p=-\frac{x}{2}\cos(x^2).
\]
Splo"sna re"sitev je
\[
\boxed{\,y(x)=Cx-\frac{x}{2}\cos(x^2).}
\]





\item{[25T]}
Površje hribovja opisuje funkcija dveh spremenljivk
\[
f(x,y)=x^4-x^2+y^4-y^2+2.
\]
Planinsko dru"stvo bi rado postavilo planinske ko"ce na vsaj sedla. V katerih to"ckah se bodo to"cke nahajale. Koliko je najve"cja in najmanj"sa vi"sina hribovja.

\textbf{Re"sitev.}
Izračunamo
\[
f_x=4x^3-2x=2x(2x^2-1), \qquad
f_y=4y^3-2y=2y(2y^2-1).
\]
Pogoj $f_x=f_y=0$ nam da
\[
x\in\Bigl\{0,\pm\frac{1}{\sqrt2}\Bigr\}, \qquad
y\in\Bigl\{0,\pm\frac{1}{\sqrt2}\Bigr\},
\]
torej je skupaj $9$ kritičnih točk.

Hessejeva matrika je enaka
\[
H_f(x,y)=
\begin{pmatrix}
12x^2-2 & 0\\
0 & 12y^2-2
\end{pmatrix}.
\]

\textbf{Klasifikacija.}
\begin{itemize}
  \item Pri $(0,0)$ imamo \emph{lokalni maksimum}, z $f(0,0)=2$.
  \item Pri $\bigl(\pm\tfrac{1}{\sqrt2},\pm\tfrac{1}{\sqrt2}\bigr)$ imamo \emph{lokalni (dejansko globalni) minimum}, z vrednostjo
  \[
  f\!\left(\pm\tfrac{1}{\sqrt2},\pm\tfrac{1}{\sqrt2}\right)
  =\Bigl(\tfrac14-\tfrac12\Bigr)+\Bigl(\tfrac14-\tfrac12\Bigr)=\tfrac32.
  \]
  \item Pri točkah $\bigl(\pm\tfrac{1}{\sqrt2},0\bigr)$ in
  $\bigl(0,\pm\tfrac{1}{\sqrt2}\bigr)$ imamo
  \emph{sedlo}.
\end{itemize}





